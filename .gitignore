# ─── Flutter / Dart ───────────────────────────────────────────────
# Build output and tool caches. All regenerated by `flutter pub get` / `flutter build`.
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/pubspec.lock.bak
**/generated_plugin_registrant.dart
*.iml
.idea/

# Android build artifacts
app/android/.gradle/
app/android/local.properties
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/android/.cxx/

# Windows build artifacts
app/windows/flutter/ephemeral/

# ─── Secrets — NEVER commit (PRD NFR-4) ───────────────────────────
# Firebase service account keys grant full admin access to the project.
**/serviceAccountKey.json
**/*-firebase-adminsdk-*.json
.env
.env.*
!.env.example

# Android signing material. Losing these means you can never update the app;
# leaking them means someone else can sign as you.
**/*.jks
**/*.keystore
app/android/key.properties

# ─── NOT ignored, deliberately ────────────────────────────────────
# app/lib/firebase_options.dart and android/app/google-services.json are
# client-side config, not secrets. Firebase API keys identify the project;
# they do not grant access. Access is controlled by Firestore security rules.
# See docs/adr/0008-committing-firebase-config.md

# ─── Node / Cloud Functions ───────────────────────────────────────
# Package manager: pnpm only, npm is forbidden (see CLAUDE.md).
# pnpm-lock.yaml IS committed; a package-lock.json appearing here means someone
# ran npm and should be deleted, not ignored.
functions/node_modules/
functions/lib/
functions/.eslintcache
pnpm-debug.log*
npm-debug.log*

# ─── Firebase CLI ─────────────────────────────────────────────────
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ─── OS noise ─────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
