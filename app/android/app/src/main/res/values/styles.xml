<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Painted by the OS while the process starts. `Theme.Black` rather than
         Flutter's default `Theme.Light`, because this app is dark-only. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Behind the Flutter UI once the engine is up. Pinned to the brand page
         colour rather than `?android:colorBackground`, which would follow the
         system theme and show white behind a dark app during a transition. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/zavithar_page</item>
    </style>
</resources>
