rules_version = '2';

// Firestore security rules for Zavithar Manager.
//
// These are the REAL enforcement layer. The Flutter forms validate too, but
// client-side checks only improve the experience — anyone can talk to Firestore
// directly with the project's public API key, so anything not forbidden here is
// allowed to the whole internet.
//
// Milestone 0 ships the ownership baseline only: you may read and write
// documents under your own user, in a known collection, and nothing else.
// Per-field type and range validation is added per module as each one is built
// (see `claude/data-model.md` → Validation strategy) — tightening rules later is
// safe, because existing data is never re-validated.
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything the app stores lives under users/{userId}/..., which is what
    // makes this single ownership check sufficient. See `claude/data-model.md`.
    match /users/{userId} {

      // The collections the app actually uses. The allowlist matters: without
      // it, an authenticated user could create arbitrary collections under
      // their own document and use the project as free storage.
      function isKnownCollection(collection) {
        return collection in [
          'transactions',
          'savings',
          'liabilities',
          'todos',
          'statements',
          'budgets',
          'categories',
          'devices'
        ];
      }

      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // The user document itself (profile/preferences, if ever needed).
      allow read, write: if isOwner();

      // --- transactions (Milestone 1) -------------------------------------
      //
      // The first collection to move past the ownership baseline onto real
      // per-field validation. The others stay on the baseline below until
      // their milestone builds them — tightening later is safe, because
      // existing documents are never re-validated.
      //
      // What this actually defends against: the project's API key is public
      // (ADR 0008), so anyone can talk to this database as *some* signed-in
      // user. Ownership stops them reading the owner's data. These rules stop
      // the owner's own account being used to store arbitrary junk, and stop a
      // buggy client writing a document the app will later crash on.
      match /transactions/{txId} {

        function data() {
          return request.resource.data;
        }

        function hasOnlyKnownKeys() {
          return data().keys().hasOnly([
            'amount', 'type', 'category', 'description',
            'date', 'account', 'createdAt', 'updatedAt'
          ])
          && data().keys().hasAll([
            'amount', 'type', 'category', 'date', 'createdAt', 'updatedAt'
          ]);
        }

        function hasValidFields() {
          return data().amount is number
              && data().amount > 0
              && data().type in ['income', 'expense']
              && data().category is string
              && data().category.size() >= 1
              && data().category.size() <= 40
              && data().date is timestamp
              // `description` and `account` are optional. Note the shape:
              // absent is fine, present-but-wrong is not.
              && (!('description' in data())
                  || (data().description is string
                      && data().description.size() <= 200))
              && (!('account' in data())
                  || (data().account is string
                      && data().account.size() <= 40));
        }

        // The document ID of the statement a given instant belongs to:
        // 2026-09. Zero-padded by hand because rules have no string
        // formatting, and `2026-9` would not match the ID the app writes.
        function periodIdOf(ts) {
          return string(ts.year()) + '-'
               + (ts.month() < 10 ? '0' + string(ts.month())
                                  : string(ts.month()));
        }

        // **The backdating guard** (ADR 0012). Once a month is closed, its
        // transactions are no longer streamed — the app reads only the open
        // period. A transaction written *into* a closed month would therefore
        // sit outside both the stream and the statement that is supposed to
        // account for it, and would vanish from the balance completely. Not
        // with an error: silently.
        //
        // The client already refuses such a date. This is the layer that
        // matters, because the API key is public (ADR 0008) and the rules are
        // the only real enforcement.
        //
        // `exists()` costs one document read per transaction write. At this
        // app's write volume that is a rounding error, and it buys the one
        // check that stops money disappearing.
        function notInAClosedMonth() {
          return !exists(/databases/$(database)/documents/users/$(userId)/statements/$(periodIdOf(data().date)));
        }

        // Audit timestamps must be the *server's* clock, not the client's.
        // `request.time` is set by Firestore when the write arrives, and
        // `FieldValue.serverTimestamp()` resolves to exactly it — so this
        // passes for an honest client and fails for one that tries to
        // backdate its own history.
        function hasServerTimestamps() {
          return data().createdAt == request.time
              && data().updatedAt == request.time;
        }

        // `createdAt` is immutable after creation. Without this an update
        // could rewrite when a transaction was first recorded.
        function keepsCreatedAt() {
          return data().createdAt == resource.data.createdAt;
        }

        allow read: if isOwner();
        allow create: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && hasServerTimestamps()
                      && notInAClosedMonth();
        allow update: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && keepsCreatedAt()
                      && data().updatedAt == request.time
                      && notInAClosedMonth();
        // Deleting out of a closed month is left allowed. Unlike a write it
        // cannot make money appear from nowhere, and forbidding it would
        // strand a bad row with no way to remove it short of reopening the
        // month — which `verify` would flag anyway.
        allow delete: if isOwner();
      }

      // --- savings (Milestone 1) -------------------------------------------
      match /savings/{goalId} {

        function data() {
          return request.resource.data;
        }

        function hasOnlyKnownKeys() {
          return data().keys().hasOnly([
            'name', 'targetAmount', 'currentAmount',
            'deadline', 'createdAt', 'updatedAt'
          ])
          && data().keys().hasAll([
            'name', 'targetAmount', 'currentAmount', 'createdAt', 'updatedAt'
          ]);
        }

        function hasValidFields() {
          return data().name is string
              && data().name.size() >= 1
              && data().name.size() <= 80
              && data().targetAmount is number
              && data().targetAmount > 0
              // May exceed the target: over-saving is real and recording it is
              // not an error.
              && data().currentAmount is number
              && data().currentAmount >= 0
              // `deadline` is optional. Absent is fine; present-but-wrong is
              // not.
              && (!('deadline' in data()) || data().deadline is timestamp);
        }

        allow read: if isOwner();
        allow create: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && data().createdAt == request.time
                      && data().updatedAt == request.time;
        allow update: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && data().createdAt == resource.data.createdAt
                      && data().updatedAt == request.time;
        allow delete: if isOwner();
      }

      // --- liabilities (Milestone 1) ---------------------------------------
      match /liabilities/{liabilityId} {

        function data() {
          return request.resource.data;
        }

        function hasOnlyKnownKeys() {
          return data().keys().hasOnly([
            'name', 'type', 'originalAmount', 'remainingAmount',
            'interestRate', 'dueDate', 'minimumPayment',
            'createdAt', 'updatedAt'
          ])
          && data().keys().hasAll([
            'name', 'type', 'originalAmount', 'remainingAmount',
            'createdAt', 'updatedAt'
          ]);
        }

        function hasValidFields() {
          return data().name is string
              && data().name.size() >= 1
              && data().name.size() <= 80
              && data().type is string
              && data().type.size() <= 40
              && data().originalAmount is number
              && data().originalAmount > 0
              // Deliberately NOT capped at originalAmount: interest and late
              // fees make a debt genuinely grow past what was borrowed, and an
              // app that refuses to record that is lying about the situation
              // it exists to track. Also not floored at 0 — an overpayment
              // should be visible rather than silently swallowed.
              && data().remainingAmount is number
              && (!('interestRate' in data())
                  || (data().interestRate is number
                      && data().interestRate >= 0
                      && data().interestRate <= 100))
              && (!('dueDate' in data()) || data().dueDate is timestamp)
              && (!('minimumPayment' in data())
                  || (data().minimumPayment is number
                      && data().minimumPayment >= 0));
        }

        allow read: if isOwner();
        allow create: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && data().createdAt == request.time
                      && data().updatedAt == request.time;
        allow update: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && data().createdAt == resource.data.createdAt
                      && data().updatedAt == request.time;
        allow delete: if isOwner();
      }


      // --- todos (Milestone 2) ---------------------------------------------
      match /todos/{todoId} {

        function data() {
          return request.resource.data;
        }

        function hasOnlyKnownKeys() {
          return data().keys().hasOnly([
            'title', 'notes', 'category', 'status',
            'deadline', 'reminderAt', 'followUpOf', 'priority',
            'createdAt', 'updatedAt', 'completedAt'
          ])
          && data().keys().hasAll([
            'title', 'category', 'status', 'createdAt', 'updatedAt'
          ]);
        }

        function hasValidFields() {
          return data().title is string
              && data().title.size() >= 1
              && data().title.size() <= 120
              && data().category is string
              && data().category.size() >= 1
              && data().category.size() <= 40
              && data().status in ['pending', 'in_progress', 'completed']
              // Optional throughout: absent is fine, present-but-wrong is not.
              && (!('notes' in data())
                  || (data().notes is string && data().notes.size() <= 1000))
              && (!('deadline' in data()) || data().deadline is timestamp)
              && (!('reminderAt' in data()) || data().reminderAt is timestamp)
              && (!('priority' in data())
                  || data().priority in ['low', 'medium', 'high'])
              // A task that follows up on itself is a cycle of one. Cheap to
              // forbid here; awkward to unpick in the UI afterwards.
              && (!('followUpOf' in data())
                  || (data().followUpOf is string
                      && data().followUpOf.size() >= 1
                      && data().followUpOf.size() <= 64
                      && data().followUpOf != todoId));
        }

        // `completedAt` is deliberately NOT pinned to request.time, unlike the
        // audit timestamps. It is written once when a task is completed and
        // then carried unchanged through every later edit — an update that
        // merely fixes a typo re-sends the document with the original value,
        // and `== request.time` would reject it. Type is enforced; the exact
        // instant is not worth breaking every edit of a finished task over.
        function hasValidCompletedAt() {
          return !('completedAt' in data()) || data().completedAt is timestamp;
        }

        // `priority` is not in `hasAll` even though the app always writes it.
        // The rules stay one step looser than the client on purpose: a document
        // written before the field existed must not become unwritable.

        allow read: if isOwner();
        allow create: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && hasValidCompletedAt()
                      && data().createdAt == request.time
                      && data().updatedAt == request.time;
        allow update: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && hasValidCompletedAt()
                      && data().createdAt == resource.data.createdAt
                      && data().updatedAt == request.time;
        allow delete: if isOwner();
      }


      // --- statements (ADR 0012) -------------------------------------------
      //
      // A closed month, summarised. The document ID is the period: `2026-09`.
      //
      // **Create and delete only — never update.** A statement is a record,
      // and records do not quietly change. Correcting a month means reopening
      // it (deleting the statement, which brings its transactions back into
      // the streamed window) and closing it again. Immutability is enforced
      // here rather than trusted to the repository, which is the whole reason
      // the rules exist.
      match /statements/{periodId} {

        function data() {
          return request.resource.data;
        }

        function hasOnlyKnownKeys() {
          return data().keys().hasOnly([
            'periodStart', 'periodEnd',
            'totalIncome', 'totalExpense',
            'openingBalance', 'closingBalance',
            'transactionCount',
            'incomeByCategory', 'expenseByCategory',
            'closedAt'
          ])
          && data().keys().hasAll([
            'periodStart', 'periodEnd',
            'totalIncome', 'totalExpense',
            'openingBalance', 'closingBalance',
            'transactionCount', 'closedAt'
          ]);
        }

        function hasValidFields() {
          return data().periodStart is timestamp
              && data().periodEnd is timestamp
              && data().periodStart < data().periodEnd
              // Totals are sums of positive amounts, so neither can be
              // negative — the sign lives in `type` on the transactions.
              && data().totalIncome is number
              && data().totalIncome >= 0
              && data().totalExpense is number
              && data().totalExpense >= 0
              // Balances carry forward and may legitimately be negative.
              && data().openingBalance is number
              && data().closingBalance is number
              && data().transactionCount is int
              && data().transactionCount >= 0
              && (!('incomeByCategory' in data())
                  || data().incomeByCategory is map)
              && (!('expenseByCategory' in data())
                  || data().expenseByCategory is map);
        }

        // The statement has to add up. This is the one rule here that checks
        // *arithmetic* rather than shape, and it is worth the line: a
        // statement whose closing balance does not follow from its own opening
        // balance and totals is not a summary of anything, and every later
        // balance is built on top of it.
        function balancesReconcile() {
          return data().closingBalance ==
                 data().openingBalance + data().totalIncome - data().totalExpense;
        }

        allow read: if isOwner();
        allow create: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && balancesReconcile()
                      && data().closedAt == request.time;
        // No `allow update` at all. Firestore denies by default, so the
        // absence *is* the rule — stated here in a comment because an absent
        // rule is easy to mistake for an oversight.
        allow delete: if isOwner();
      }


      // --- budgets (Milestone 4) --------------------------------------------
      //
      // The document ID is the category, which is what makes a second budget
      // for the same category impossible to create rather than merely
      // discouraged. The `category` field is a readable copy of the ID, and the
      // rules insist the two agree — otherwise a document could claim to budget
      // `rent` while living under `groceries`, and every screen would disagree
      // about which one it was.
      match /budgets/{category} {

        function data() {
          return request.resource.data;
        }

        function hasOnlyKnownKeys() {
          return data().keys().hasOnly([
            'category', 'monthlyLimit', 'createdAt', 'updatedAt'
          ])
          && data().keys().hasAll(['category', 'monthlyLimit', 'updatedAt']);
        }

        function hasValidFields() {
          return data().category is string
              && data().category == category
              && data().monthlyLimit is number
              // A limit of zero is not a budget, it is a ban, and nothing here
              // could enforce one.
              && data().monthlyLimit > 0;
        }

        allow read: if isOwner();
        allow create: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && data().createdAt == request.time
                      && data().updatedAt == request.time;
        // `createdAt` is absent from an update's payload and preserved by the
        // merge, so — unlike the other collections — it is compared only when
        // it is actually present.
        allow update: if isOwner()
                      && hasOnlyKnownKeys()
                      && hasValidFields()
                      && (!('createdAt' in data())
                          || data().createdAt == resource.data.createdAt)
                      && data().updatedAt == request.time;
        allow delete: if isOwner();
      }

      // --- everything else: Milestone 0 ownership baseline -----------------
      //
      // categories and devices. Each graduates to its own validated block as
      // its milestone lands — though `devices` may never, since ADR 0011
      // removed the Cloud Function that was going to read the FCM tokens it
      // held, leaving it dead schema.
      //
      // **The exclusion list is load-bearing.** This wildcard also matches
      // `transactions/{id}`, `savings/{id}` and `liabilities/{id}`, and
      // Firestore evaluates every matching rule and allows a write if *any one*
      // of them allows it — they are OR-ed, not AND-ed. Without these
      // `!=` clauses, the strict blocks above would enforce nothing at all
      // while looking completely correct in this file.
      //
      match /{collection}/{docId} {
        allow read, write: if isOwner()
                           && isKnownCollection(collection)
                           && !(collection in [
                                'transactions', 'savings', 'liabilities',
                                'todos', 'statements', 'budgets'
                              ]);
      }
    }

    // Anything not matched above is denied. This is Firestore's default, but
    // stating it makes the intent explicit to the next person reading the file.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
